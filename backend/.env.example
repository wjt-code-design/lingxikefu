# =============================================================
# Lingxi 智能客服系统 · 环境变量占位模板（严禁填真实值）
# 复制为 .env 后填入真实配置。真实密钥只经 secret 管理（env/KMS）注入，
# 任何真实密钥 / endpoint 提交仓库将被 gitleaks 扫描拦截（红线⑨）。
# =============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lingxi
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=lingxi

# --- Redis（会话上下文 / 配额计数 / Celery broker） ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant（向量库） ---
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=__CHANGE_ME__

# --- JWT（必须替换为随机密钥，validate() 拒绝占位值启动） ---
JWT_SECRET=__CHANGE_ME__

# --- 租户（MVP 单租户，Phase3 启用行级过滤） ---
TENANT_DEFAULT=default

# --- LiteLLM 网关（百炼 Key 由网关注入，禁止直写真实值） ---
LITELLM_MASTER_KEY=__CHANGE_ME__

# --- CORS（JSON 数组格式；MVP 仅 Web 挂件，前端 Vite dev 端口 5173） ---
CORS_ORIGINS=["http://localhost:5173"]
