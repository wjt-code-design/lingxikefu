# =============================================================
# Lingxi 智能客服系统 · 环境变量占位模板（严禁填真实值）
# 复制为 .env 后填入真实配置。真实密钥只经 secret 管理（env/KMS）注入，
# 任何真实密钥 / endpoint 提交仓库将被 gitleaks 扫描拦截（红线⑨）。
# =============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lingxi
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=lingxi

# --- Redis（会话上下文 / 配额计数 / Celery broker） ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant（向量库） ---
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=__CHANGE_ME__

# --- JWT（必须替换为随机密钥，validate() 拒绝占位值启动） ---
JWT_SECRET=__CHANGE_ME__

# --- 租户（MVP 单租户，Phase3 启用行级过滤） ---
TENANT_DEFAULT=default

# --- LiteLLM 网关（百炼 Key 由网关注入，禁止直写真实值） ---
LITELLM_MASTER_KEY=__CHANGE_ME__

# --- 智谱 GLM 备用通道（可选：CHAT_PROVIDER=zhipu 时必填；缺失时该 provider 启动报错） ---
# ZHIPU_API_KEY=__CHANGE_ME__

# --- 模型（ADR-3：百炼 + LiteLLM；embedding 本地 bge 优先） ---
# 复制本文件为 .env 后，把真实百炼 Key 填入 DASHSCOPE_API_KEY（勿提交，gitleaks 拦截）
# DASHSCOPE_API_KEY=sk-__CHANGE_ME__
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-flash-2026-07-15
# CHAT_MODEL_FALLBACK=deepseek-v4-flash-0731
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RAG_ENABLE_RERANK=false
# RERANK_MODEL=gte-rerank-v2

# --- CORS（JSON 数组格式；MVP 仅 Web 挂件，前端 Vite dev 端口 5173） ---
CORS_ORIGINS=["http://localhost:5173"]

# --- 可信反向代理直连 IP（安全） ---
# 仅当 TCP 对端（request.client.host）命中白名单时，才信任 X-Forwarded-For 首段为客户端 IP
# （登录/注册限流按 IP 计数）。留空=忽略 XFF，恒用 TCP 对端（fail-closed，防伪造 IP 绕过限流）。
# 部署在 Nginx/Caddy 之后且要走真实客户端 IP 时，填代理服务器的直连 IP（JSON 数组），例如：
# TRUSTED_PROXIES=["10.0.0.1","10.0.0.2"]
TRUSTED_PROXIES=[]
