# =============================================================
# Lingxi 智能客服系统 · 环境变量占位模板（严禁填真实值）
# 复制为 .env 后填入真实配置。真实密钥只经 secret 管理（env/KMS）注入，
# 任何真实密钥 / endpoint 提交仓库将被 gitleaks 扫描拦截（红线⑨）。
# =============================================================

# --- PostgreSQL ---
# 本机裸进程形态填 localhost；docker-compose 容器内跑（api/migrate/worker）时无需改本值——
# compose 的 x-api-environment 会以服务名 postgres 覆盖（environment 优先级高于 env_file）。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lingxi
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=lingxi

# --- Redis（会话上下文 / 配额计数 / Celery broker）---
# 同上：本机 localhost，容器内由 compose 覆盖为 redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Qdrant（向量库）---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=__CHANGE_ME__

# --- JWT（必须替换为随机密钥，validate() 拒绝占位值启动） ---
JWT_SECRET=__CHANGE_ME__

# --- 租户（MVP 单租户，Phase3 启用行级过滤） ---
TENANT_DEFAULT=default

# --- 对话模型（OpenAI 兼容端点；Key 只经 env 注入，严禁提交；缺失时启动报错） ---
# ⚠️ 变量名沿用 LONGCAT_* 但实际可指向**任意 OpenAI 兼容平台**（历史命名）。
#    当前部署：阿里云百炼业务空间专属端点（华北2·北京）。
#    换平台只需改这三行，无需动代码。
LONGCAT_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LONGCAT_CHAT_MODEL=qwen3.8-flash
# LONGCAT_API_KEY=sk-__CHANGE_ME__
# 思维链开关（qwen3.8 系列为混合思考模型，默认开思考）：思维链经 SSE reasoning 事件透传前端，
# 用户感知首反馈 ~2s；false 关思考（content 首字更快，但拒答锚点通过率会下降——实测数据随模型而变，
# 换模型后需重测，见 eval-and-samples/BASELINE.md）。
LLM_ENABLE_THINKING=true
# 思考参数风格：**随平台而变，传错会被静默忽略或 400**
# - chat_template_kwargs：LongCat / vLLM 系（嵌套）
# - top_level：百炼 OpenAI 兼容模式（顶层 enable_thinking 字段）
LLM_THINKING_PARAM_STYLE=top_level

# --- 视觉模型（Image Agent 图片理解；OpenAI 兼容，content 数组 + image_url） ---
# 变量名沿用 VOLCENGINE_* 但实际可指向任意 OpenAI 兼容平台。当前同为百炼 qwen3.8-flash。
VOLCENGINE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VOLCENGINE_CHAT_MODEL=qwen3.8-flash
# VOLCENGINE_API_KEY=sk-__CHANGE_ME__

# --- embedding（本地，0 成本、不出境） ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5

# --- rerank（文本重排） ---
# ⚠️ 百炼 rerank **不走 OpenAI 兼容端点**：打 {base}/compatible-mode/v1/rerank 返回
#    HTTP 404 + 空响应体（无错误说明，最难排查的一类）。必须用原生 DashScope 路径：
#    {RERANK_BASE_URL}/api/v1/services/rerank/text-rerank/text-rerank
#    RERANK_BASE_URL 只填到域名，勿带 /compatible-mode/v1。
RERANK_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
RERANK_MODEL=qwen3.7-text-rerank
# RERANK_API_KEY=sk-__CHANGE_ME__
RAG_ENABLE_RERANK=false
# 送入重排的候选数（取混合召回前 N 条）/ 重排后保留条数
# RERANK_CANDIDATES=24
# RERANK_TOP_N=5

# --- CORS（JSON 数组格式；MVP 仅 Web 挂件，前端 Vite dev 端口 5173） ---
CORS_ORIGINS=["http://localhost:5173"]

# --- 可信反向代理直连 IP（安全） ---
# 仅当 TCP 对端（request.client.host）命中白名单时，才信任 X-Forwarded-For 首段为客户端 IP
# （登录/注册限流按 IP 计数）。留空=忽略 XFF，恒用 TCP 对端（fail-closed，防伪造 IP 绕过限流）。
# 部署在 Nginx/Caddy 之后且要走真实客户端 IP 时，填代理服务器的直连 IP（JSON 数组），例如：
# TRUSTED_PROXIES=["10.0.0.1","10.0.0.2"]
TRUSTED_PROXIES=[]
